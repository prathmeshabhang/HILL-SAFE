# =====================================================================
# FLOODY SHIELD — MULTI-SOURCE CREDENTIAL & API KEY CONFIGURATION
# =====================================================================
# Add multiple API keys separated by commas for automatic round-robin
# rotation, load balancing, and rate-limit fallback (HTTP 429 recovery).
# =====================================================================

# 1. Copernicus Data Space Ecosystem (Sentinel-1 SAR & Sentinel-2 MSI)
# Accepts single key or comma-separated pool
COPERNICUS_API_KEYS=your_copernicus_client_id_1:secret_1,your_copernicus_client_id_2:secret_2

# 2. NASA Earthdata (GPM IMERG, SMAP Soil Moisture, SRTM/DEM)
# Accepts single bearer token or comma-separated pool
EARTHDATA_TOKENS=your_earthdata_bearer_token_1,your_earthdata_bearer_token_2

# 3. Google Gemini API (Multimodal Reasoning & Early Warning Dispatch)
# Accepts single key or comma-separated pool
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2

# 4. OpenWeatherMap / Weather API (Local station telemetry backup)
OPENWEATHER_API_KEYS=your_openweather_key_1,your_openweather_key_2

# 5. Study Basin Configuration
FLOODY_STUDY_AREA=Upper_Beas_HP
FLOODY_LOG_LEVEL=INFO

# =====================================================================
# FLOODY SHIELD v3.3 — OPERATIONAL PLATFORM CONFIGURATION
# =====================================================================

# Database Configuration (PostgreSQL with PostGIS extension for production)
DATABASE_URL=postgresql://floody_user:floody_secret_password@localhost:5432/floody_shield
# Fallback local sqlite for development:
# DATABASE_URL=sqlite:///./data/floody_shield.db

# Environment & Application Version
ENVIRONMENT=development
APP_VERSION=4.0.0

# Cryptographic Security & RBAC Auth
SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALERT_CRYPTO_KEY=floody_hpsdma_eoc_ed25519_alert_authorization_secret_key_2026

# EOC Emergency Incident Commander Credentials (Seed Commander)
INITIAL_COMMANDER_USERNAME=commander_kullu
INITIAL_COMMANDER_PASSWORD=ReplaceWithStrongPass2026!
INITIAL_COMMANDER_BADGE=HPSDMA_EOC_CMD_01

# Hardware & Physical LoRa Gateway
LORA_GATEWAY_ID=GW_ROHTANG_01

# Real-Time WebSocket & Ingestion Limits
MAX_WEBSOCKET_CONNECTIONS=200
WS_HEARTBEAT_INTERVAL_SEC=30
TELEMETRY_CLOCK_SKEW_TOLERANCE_MIN=120
TELEMETRY_STALE_THRESHOLD_MIN=360

# Upper Beas Basin Bounding Box (Kullu-Manali Corridor)
UPPER_BEAS_LAT_MIN=31.50
UPPER_BEAS_LAT_MAX=32.50
UPPER_BEAS_LON_MIN=76.80
UPPER_BEAS_LON_MAX=77.60

